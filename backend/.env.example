DB_HOST=db
DB_PORT=3306
DB_USER=weconnect
DB_PASSWORD=change-this
DB_NAME=weconnect

SECRET_KEY=change-this-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
RESET_TOKEN_EXPIRE_MINUTES=10

OTP_EXPIRE_MINUTES=5
OTP_FROM_NAME=WeConnect

# Brevo API config (dùng cho OTP qua email, HTTP/HTTPS port 443)
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BREVO_FROM_EMAIL=otp@example.com

# Gemini AI (optional, for translation feature)
GEMINI_API_KEY=

# Pusher Config
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=

# LiveKit Config
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=10
